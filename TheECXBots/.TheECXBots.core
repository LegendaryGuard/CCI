@BotMenuDebugSwitchCommand( Client, key )
{
	switch( key )
	{
		case 0:
		{
			if( Menu_DebugType == DebugType_Shoot ) client_cmd( Client, "botsshoot 1" );
			if( Menu_DebugType == DebugType_Search ) client_cmd( Client, "botssearchenemies 1" );
			if( Menu_DebugType == DebugType_Ignore ) client_cmd( Client, "observer 1" );
			if( Menu_DebugType == DebugType_Move ) client_cmd( Client, "botsmove 1" );
		}
		case 1:
		{
			if( Menu_DebugType == DebugType_Shoot ) client_cmd( Client, "botsshoot 0" );
			if( Menu_DebugType == DebugType_Search ) client_cmd( Client, "botssearchenemies 0" );
			if( Menu_DebugType == DebugType_Ignore ) client_cmd( Client, "observer 0" );
			if( Menu_DebugType == DebugType_Move ) client_cmd( Client, "botsmove 0" );
		}
	}

	return PLUGIN_HANDLED
}

@BotClassID() if( is_user_bot( get_msg_arg_int( 1 ) ) ) set_msg_arg_int( 5, ARG_BYTE, 10 );

@BotInitiateTransformation( MsgID, dest )
{
	new Client = get_msg_arg_int( 1 );

	/* Use CCI Custom Transformation FX

	new Class = getClientDATAc( Client, cliClass );

	if( !is_user_bot( Client ) ) return;

	setClientFrozen( Client, true );

	ForceCall( getClassDATAc( Class, cxPlugin ), "@ClassInitiateTransformation", "ccc", Client, 1, false );

	new AscendTime[ 5 ];
	float_to_str( getLevelDATAc( Class, 1, cxlAscendTime ), AscendTime, 5 );
	set_task( str_to_float( AscendTime ), "@BotFinishTransformation", Client );

	*/

	if( !is_user_bot( Client ) ) return;

	setClientDATAc( Client, cliLevel, 1 );

	new Class = getClientDATAc( Client, cliClass );

	new PowerupColor[ 3 ];
	getLevelDATAv( Class, 1, cxlPowerUp, PowerupColor, 3 );

	new szModel[ 65 ];
	getLevelDATAv( Class, 1, cxlAuraModel, szModel, 65 );

	for( new i; i < 25; i++ ) 
	{
		new org[ 3 ]; 
		get_user_origin( Client, org );
		message_begin( MSG_ALL, SVC_TEMPENTITY, org );
		write_byte( TE_BEAMENTPOINT );
		write_short( Client );
		write_coord( org[0] + random_num( -200, 200 ) );
		write_coord( org[1] + random_num( -200, 200 ) );
		write_coord( org[2] + random_num( -200, 200 ) );
		write_short( engfunc( EngFunc_ModelIndex, "sprites/stmbal1.spr" ) );
		write_byte( 5 );
		write_byte( 5 );
		write_byte( 100 );
		write_byte( 25 );
		write_byte( 5 );
		write_byte( PowerupColor[ 0 ] );
		write_byte( PowerupColor[ 1 ] ); 
		write_byte( PowerupColor[ 2 ] );
		write_byte( 255 );
		write_byte( 25 );
		message_end(); 
	}

	AddFx( Client, "fxModelEntity", szModel, 0, 0, 50.0, 0, 0, 0, 1.0, 0.4, 0, getLevelDATAc( Class, 1, cxlAuraSkin ) );
	AddFx( Client, "fxPowerup", 0, 0, 0 ); emit_sound( Client, CHAN_WEAPON, "evolution/null.wav", 1.0, ATTN_NORM, 0, PITCH_NORM );
	AddFx( Client, "fxLgtField", 0.3 , 1, 255, 200, 20 );

	set_task( 9.5, "@BotFinishTransformation", Client );
}

@BotCancelTransformation( MsgID, dest )
{
	new Client = get_msg_arg_int( 1 );

	// CL_FROZEN[ Client ] = false;

	if( !is_user_connected( Client ) )
	{
		remove_task( Client );
		return;
	}

	if( getClientDATAc( Client, cliLevel ) != 1 ) setClientDATAc( Client, cliLevel, 0 );

	message_begin( MSG_BROADCAST, SVC_TEMPENTITY );
	write_byte( TE_KILLBEAM );
	write_short( Client );
	message_end();

	RemFx( Client, "fxModelEntity", 0 );
	RemFx( Client, "fxPowerup", 0 );
	RemFx( Client, "fxLgtField", 0 );

	remove_task( Client );
}

@BotFinishTransformation( Client )
{
	/* CCI Custom Transformation FX Finish

	new Class = getClientDATAc( Client, cliClass );

	ForceCall( getClassDATAc( Class, cxPlugin ), "@ClassFinishTransformation", "cc", Client, 1 );

	setClientFrozen( Client, false );

	*/

	if( !is_user_connected( Client ) ) return;

	setClientDATAc( Client, cliLevel, 1 );

	RemFx( Client, "fxModelEntity", 0 );
	RemFx( Client, "fxPowerup", 0 );
	RemFx( Client, "fxLgtField", 0 );

	AddFx( Client, "fxBlow" );
	AddFx( Client, "fxPowerWave", "sprites/white.spr", 180, 145, 120, 30, 250 );
}

@BotSetData( MsgID, dest, Client )
{
	if( !is_user_bot( Client ) ) return;

	if( getClientDATAc( Client, cliClass ) == -1 )
	{
		if( Bot_Class == 0 ) return;

		new CORE[ 2 ];

		CORE[ 0 ] = Client;
		CORE[ 1 ] = Bot_Class - 1;

		setClientDATAc( Client, cliClass, Bot_Class - 1 );
		setClientDATAc( Client, cliLevel, 0 );
		setClientPL( Client, getLevelDATAc( Bot_Class - 1, 0, cxlRequiredPL ) );

		set_task( 0.000_001, "@BotSetClass", Client, CORE, 2 );

		Bot_Class = 0;
	}
}

@BotSetClass( CORE[] ) if( is_user_bot( CORE[ 0 ] ) ) forceClientCLASS( CORE[ 0 ], CORE[ 1 ], 0, true, true );

public client_PostThink( Client )
{
	if( get_cvar_float( "mp_spawn_invulnerable_time" ) > 0.000_000 )
		set_cvar_float( "mp_spawn_invulnerable_time", 0.000_000 ); // If > 0.0 the game crashes.

	if( !is_user_bot( Client ) ) return;

	if( getClientDATAc( Client, cliLevel ) == 0 )
	{
		setClientPL( Client, getLevelDATAc( getClientDATAc( Client, cliClass ), 0, cxlRequiredPL ) );

		new szModel[ 23 ];
		getLevelDATAv( getClientDATAc( Client, cliClass ), 0, cxlModel, szModel, 23 );
		setClientMODEL( Client, szModel );
	}
	if( getClientDATAc( Client, cliLevel ) == 1 )
	{
		setClientPL( Client, getLevelDATAc( getClientDATAc( Client, cliClass ), 0, cxlRequiredPL ) * 2 );

		if( getLevelDATAc( getClientDATAc( Client, cliClass ), 1, cxlModelIndex ) != 0 )
		{
			new szModel[ 23 ];
			getLevelDATAv( getClientDATAc( Client, cliClass ), 1, cxlModel, szModel, 23 );
			setClientMODEL( Client, szModel );
		}
	}
}

