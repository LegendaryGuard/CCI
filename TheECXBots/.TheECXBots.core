}

@BotMenuClass( Client )
{
	new szMenuBody[ 256 ];
	new keys;

	new nLen = format( szMenuBody, 255, "Select Class - Page: %d^n", Menu_CurPage );

	if( getClassExtensionCount() > 9 )
	{
		Bot_Page = floatround( ( ( float( getClassExtensionCount() ) - 8.0 ) / 7.0 ) + 1.0, floatround_ceil );

		new ClassName[ 33 ], MenuBodyName[ 33 ];

		if( Menu_CurPage > 1 )
		{
			if( Menu_CurPage < Bot_Page )
			{
				for( new i; i <= 9; i++ )
				{
					if( i == 7 )
						formatex( MenuBodyName, 32, "^n^n8: Last" );
					else if( i == 8 )
						formatex( MenuBodyName, 32, "^n9: Next" );
					else if( i == 9 )
						formatex( MenuBodyName, 32, "^n0: Exit" );
					else
					{
						getClassDATAv( ( ( Menu_CurPage - 1 ) * 7 ) + ( i + 1 ), cxName, ClassName, 32 );

						formatex( MenuBodyName, 32, "^n%d: %s", i + 1, ClassName );
					}

					nLen += format( szMenuBody[ nLen ], 255-nLen, MenuBodyName );
				}

				keys = ( 1<<0|1<<1|1<<2|1<<3|1<<4|1<<5|1<<6|1<<7|1<<8|1<<9 );
			}
			else
			{
				for( new i; i <= getClassExtensionCount() - ( ( Bot_Page - 1 ) * 7 ); i++ )
				{
					if( i == getClassExtensionCount() - ( ( Bot_Page - 1 ) * 7 ) - 1 )
						formatex( MenuBodyName, 32, "^n^n8: Last" );
					else if( i == getClassExtensionCount() - ( ( Bot_Page - 1 ) * 7 ) )
						formatex( MenuBodyName, 32, "^n0: Exit" );
					else
					{
						getClassDATAv( ( ( Menu_CurPage - 1 ) * 7 ) + ( i + 1 ), cxName, ClassName, 32 );

						formatex( MenuBodyName, 32, "^n%d: %s", i + 1, ClassName );
					}

					nLen += format( szMenuBody[ nLen ], 255-nLen, MenuBodyName );
				}

				switch( getClassExtensionCount() - ( ( Bot_Page - 1 ) * 7 ) - 1 )
				{
					case 1: keys = ( 1<<0|1<<7|1<<9 );
					case 2: keys = ( 1<<0|1<<1|1<<7|1<<9 );
					case 3: keys = ( 1<<0|1<<1|1<<2|1<<7|1<<9 );
					case 4: keys = ( 1<<0|1<<1|1<<2|1<<3|1<<7|1<<9 );
					case 5: keys = ( 1<<0|1<<1|1<<2|1<<3|1<<4|1<<7|1<<9 );
					case 6: keys = ( 1<<0|1<<1|1<<2|1<<3|1<<4|1<<5|1<<7|1<<9 );
					case 7: keys = ( 1<<0|1<<1|1<<2|1<<3|1<<4|1<<5|1<<6|1<<7|1<<9 );
				}
			}
		}
		else
		{
			for( new i; i <= 9; i++ )
			{
				if( i == 8 )
					formatex( MenuBodyName, 32, "^n^n9: Next" );
				else if( i == 9 )
					formatex( MenuBodyName, 32, "^n0: Exit" );
				else
				{
					getClassDATAv( i, cxName, ClassName, 32 );

					formatex( MenuBodyName, 32, "^n%d: %s", i + 1, ClassName );
				}

				nLen += format( szMenuBody[ nLen ], 255-nLen, MenuBodyName );
			}

			keys = ( 1<<0|1<<1|1<<2|1<<3|1<<4|1<<5|1<<6|1<<7|1<<8|1<<9 );
		}
	}
	else
	{
		Bot_Page = 1;

		new ClassName[ 33 ], MenuBodyName[ 33 ];

		for( new i; i <= getClassExtensionCount(); i++ )
		{
			if( i == getClassExtensionCount() )
				formatex( MenuBodyName, 32, "^n^n0: Exit" );
			else
			{
				getClassDATAv( i, cxName, ClassName, 32 );

				formatex( MenuBodyName, 32, "^n%d: %s", i + 1, ClassName );
			}

			nLen += format( szMenuBody[ nLen ], 255-nLen, MenuBodyName );
		}

		switch( getClassExtensionCount() )
		{
			case 0: keys = ( 1<<9 );
			case 1: keys = ( 1<<0|1<<9 );
			case 2: keys = ( 1<<0|1<<1|1<<9 );
			case 3: keys = ( 1<<0|1<<1|1<<2|1<<9 );
			case 4: keys = ( 1<<0|1<<1|1<<2|1<<3|1<<9 );
			case 5: keys = ( 1<<0|1<<1|1<<2|1<<3|1<<4|1<<9 );
			case 6: keys = ( 1<<0|1<<1|1<<2|1<<3|1<<4|1<<5|1<<9 );
			case 7: keys = ( 1<<0|1<<1|1<<2|1<<3|1<<4|1<<5|1<<6|1<<9 );
			case 8: keys = ( 1<<0|1<<1|1<<2|1<<3|1<<4|1<<5|1<<6|1<<7|1<<9 );
			case 9: keys = ( 1<<0|1<<1|1<<2|1<<3|1<<4|1<<5|1<<6|1<<7|1<<8|1<<9 );
		}
	}

	show_menu( Client, keys, szMenuBody, -1 );
}

