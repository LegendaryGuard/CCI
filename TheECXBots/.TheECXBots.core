enum
{
	DebugType_Shoot = 1,
	DebugType_Search,
	DebugType_Ignore,
	DebugType_Move,
};

public plugin_init ()
{
	register_plugin( "The ECX Bots", "3.0", "ESFKAMI" );

	register_message( get_user_msgid( "TransformFX" ), "@BotInitiateTransformation" );
	register_message( get_user_msgid( "StopTransFX" ), "@BotCancelTransformation" );
	register_message( get_user_msgid( "Transform" ), "@BotSetData" );
	register_message( get_user_msgid( "ShowMenu" ), "@BotMenuInitiation" );
	register_message( get_user_msgid( "ScoreInfo" ), "@BotClassID" );

	register_menucmd( register_menuid( "ECX-Bot Menu" ), 1023, "@BotMenuCommand" );

	register_menucmd( register_menuid( "Select Skill" ), 1023, "@BotMenuSkillCommand" );
	register_menucmd( register_menuid( "Select Team" ), 1023, "@BotMenuTeamCommand" );
	register_menucmd( register_menuid( "Select Class - Page: " ), 1023, "@BotMenuClassCommand" );

	register_menucmd( register_menuid( "Advanced Settings" ), 1023, "@BotMenuAdvancedCommand" );
	register_menucmd( register_menuid( "Set Skill" ), 1023, "@BotMenuSetSkillCommand" );
	register_menucmd( register_menuid( "Set Percent" ), 1023, "@BotMenuSetPercentCommand" );
	register_menucmd( register_menuid( "Select Percent" ), 1023, "@BotMenuSelectPercentCommand" );
	register_menucmd( register_menuid( "Set Balancing" ), 1023, "@BotMenuSetBalancingCommand" );
	register_menucmd( register_menuid( "Use Disc" ), 1023, "@BotMenuUseDiscCommand" );
	register_menucmd( register_menuid( "Set Aggression" ), 1023, "@BotMenuSetAggressionCommand" );

	register_menucmd( register_menuid( "Bot Chat" ), 1023, "@BotMenuBotChatCommand" );
	register_menucmd( register_menuid( "Chat Switch" ), 1023, "@BotMenuChatSwitchCommand" );
	register_menucmd( register_menuid( "Choose Percent" ), 1023, "@BotMenuChoosePercentCommand" );

	register_menucmd( register_menuid( "Bot Kick" ), 1023, "@BotMenuBotKickCommand" );

	register_menucmd( register_menuid( "Bot Debug" ), 1023, "@BotMenuBotDebugCommand" );
	register_menucmd( register_menuid( "Debug Switch" ), 1023, "@BotMenuDebugSwitchCommand" );

	Menu_CurPage = 1;
}

@BotMenuInitiation( MsgID, dest, Client )
{
	if( get_msg_arg_int( 1 ) != 1023 ) return;

	new MenuBody[ 200 ];
	get_msg_arg_string( 4, MenuBody, 200 );

	MenuBody[ 1 ] = 'C';
	MenuBody[ 2 ] = 'X';

	set_msg_arg_string( 4, MenuBody );

	Bot_Skill = 0;

	new keys = ( 1<<0|1<<1|1<<2|1<<3|1<<4|1<<5|1<<6|1<<7|1<<8|1<<9 );

	show_menu( Client, keys, MenuBody, -1 );
}

@BotMenuSkill( Client )
{
	new szMenuBody[ 256 ];
	new keys;

	new nLen = format( szMenuBody, 255, "Select Skill^n" );

	nLen += format( szMenuBody[ nLen ], 255-nLen, "^n1: Best" );
	nLen += format( szMenuBody[ nLen ], 255-nLen, "^n2: Good" );
	nLen += format( szMenuBody[ nLen ], 255-nLen, "^n3: Medium" );
	nLen += format( szMenuBody[ nLen ], 255-nLen, "^n4: Weak" );
	nLen += format( szMenuBody[ nLen ], 255-nLen, "^n5: Bad" );
	nLen += format( szMenuBody[ nLen ], 255-nLen, "^n6: Default" );
	nLen += format( szMenuBody[ nLen ], 255-nLen, "^n7: Random" );
	nLen += format( szMenuBody[ nLen ], 255-nLen, "^n^n0: Exit" );

	keys = ( 1<<0|1<<1|1<<2|1<<3|1<<4|1<<5|1<<6|1<<9 );

	show_menu( Client, keys, szMenuBody, -1 );
}

