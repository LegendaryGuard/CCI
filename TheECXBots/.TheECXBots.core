#include < ipci/Core >
#include < ipci/FXLib >

new Bot_Skill, Bot_Team, Bot_Page, Bot_Class;
new Menu_CurPage, Menu_PercentType, Menu_ChatType, Menu_DebugType;
// new bool: CL_FROZEN[33]; /* Bot Frozen */

enum
{
	BotSkill_Best = 1,
	BotSkill_Good,
	BotSkill_Medium,
	BotSkill_Weak,
	BotSkill_Bad,
};

