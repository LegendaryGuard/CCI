@BotMenuCommand( Client, key )
{
	switch( key )
	{
		case 0:
		{
			if( getClassExtensionCount() > 0 )
				Bot_Class = random_num( 1, getClassExtensionCount() );
			else
				Bot_Class = 0;

			new szCommand[ 18 ];
			formatex( szCommand, 17, "addbot %d 9 * %d", random_num( BotTeam_Good, BotTeam_Evil ), random_num( BotSkill_Best, BotSkill_Bad ) );
			client_cmd( Client, szCommand );
		}
		case 1: @BotMenuSkill( Client );
		case 2: client_print( Client, print_chat, "[EN]Disabled because of the bugs of SBOT." );
		case 3: client_print( Client, print_chat, "[EN]Disabled because of the delay of filling." );
		case 4: @BotMenuAdvanced( Client );
		case 5: @BotMenuChat( Client );
		case 6: client_cmd( Client, "botkicklast" );
		case 7: @BotMenuKick( Client );
		case 8: @BotMenuDebug( Client );
	}

	return PLUGIN_HANDLED
}

@BotMenuSkillCommand( Client, key )
{
	switch( key )
	{
		case 0: Bot_Skill = BotSkill_Best;
		case 1: Bot_Skill = BotSkill_Good;
		case 2: Bot_Skill = BotSkill_Medium;
		case 3: Bot_Skill = BotSkill_Weak;
		case 4: Bot_Skill = BotSkill_Bad;
		case 5: Bot_Skill = BotSkill_Weak;
		case 6: Bot_Skill = random_num( BotSkill_Best, BotSkill_Bad );
		case 9: Bot_Skill = 0;
	}

	if( Bot_Skill != 0 )
	{
		@BotMenuTeam( Client );
	}

	return PLUGIN_HANDLED
}

@BotMenuTeamCommand( Client, key )
{
	switch( key )
	{
		case 0: Bot_Team = BotTeam_Good;
		case 1: Bot_Team = BotTeam_Evil;
		case 2: Bot_Team = random_num( BotTeam_Good, BotTeam_Evil );
		case 9: Bot_Team = 0;
	}

	if( Bot_Team != 0 )
	{
		@BotMenuClass( Client );
	}

	return PLUGIN_HANDLED
}

@BotMenuClassCommand( Client, key )
{
	if( Bot_Page > 1 )
	{
		if( Menu_CurPage > 1 )
		{
			if( Menu_CurPage < Bot_Page )
			{
				switch( key )
				{
					case 0: Bot_Class = ( ( Menu_CurPage - 1 ) * 7 ) + ( key + 1 + 1 );
					case 1: Bot_Class = ( ( Menu_CurPage - 1 ) * 7 ) + ( key + 1 + 1 );
					case 2: Bot_Class = ( ( Menu_CurPage - 1 ) * 7 ) + ( key + 1 + 1 );
					case 3: Bot_Class = ( ( Menu_CurPage - 1 ) * 7 ) + ( key + 1 + 1 );
					case 4: Bot_Class = ( ( Menu_CurPage - 1 ) * 7 ) + ( key + 1 + 1 );
					case 5: Bot_Class = ( ( Menu_CurPage - 1 ) * 7 ) + ( key + 1 + 1 );
					case 6: Bot_Class = ( ( Menu_CurPage - 1 ) * 7 ) + ( key + 1 + 1 );
					case 7:
					{
						Bot_Class = 0;
						Menu_CurPage--;
						@BotMenuClass( Client );
					}
					case 8:
					{
						Bot_Class = 0;
						Menu_CurPage++;
						@BotMenuClass( Client );
					}
					case 9: Bot_Class = 0;
				}
			}
			else
			{
				switch( key )
				{
					case 0: Bot_Class = ( ( Bot_Page - 1 ) * 7 ) + ( key + 1 + 1 );
					case 1: Bot_Class = ( ( Bot_Page - 1 ) * 7 ) + ( key + 1 + 1 );
					case 2: Bot_Class = ( ( Bot_Page - 1 ) * 7 ) + ( key + 1 + 1 );
					case 3: Bot_Class = ( ( Bot_Page - 1 ) * 7 ) + ( key + 1 + 1 );
					case 4: Bot_Class = ( ( Bot_Page - 1 ) * 7 ) + ( key + 1 + 1 );
					case 5: Bot_Class = ( ( Bot_Page - 1 ) * 7 ) + ( key + 1 + 1 );
					case 6: Bot_Class = ( ( Bot_Page - 1 ) * 7 ) + ( key + 1 + 1 );
					case 7:
					{
						Bot_Class = 0;
						Menu_CurPage--;
						@BotMenuClass( Client );
					}
					case 9: Bot_Class = 0;
				}
			}
		}
		else
		{
			switch( key )
			{
				case 0: Bot_Class = 1;
				case 1: Bot_Class = 2;
				case 2: Bot_Class = 3;
				case 3: Bot_Class = 4;
				case 4: Bot_Class = 5;
				case 5: Bot_Class = 6;
				case 6: Bot_Class = 7;
				case 7: Bot_Class = 8;
				case 8:
				{
					Bot_Class = 0;
					Menu_CurPage++;
					@BotMenuClass( Client );
				}
				case 9: Bot_Class = 0;
			}
		}
	}
	else
	{
		switch( key )
		{
			case 0: Bot_Class = 1;
			case 1: Bot_Class = 2;
			case 2: Bot_Class = 3;
			case 3: Bot_Class = 4;
			case 4: Bot_Class = 5;
			case 5: Bot_Class = 6;
			case 6: Bot_Class = 7;
			case 7: Bot_Class = 8;
			case 8: Bot_Class = 9;
			case 9: Bot_Class = 0;
		}
	}

	if( Bot_Class != 0 )
	{
		//Menu_CurPage = 0; /* Initialize the menu start page. */

		new szCommand[ 18 ];
		formatex( szCommand, 17, "addbot %d 9 * %d", Bot_Team, Bot_Skill );
		client_cmd( Client, szCommand );
	}

	return PLUGIN_HANDLED
}

